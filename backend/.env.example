# ==========================================
# VARIÁVEIS DE AMBIENTE - MÁQUINA LOCAL
# (Preencha com seus dados locais e renomeie este arquivo para .env)
# ==========================================

# Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=recanto_camargo_teste

# Segredos de Segurança (Não use esses em produção!)
JWT_SECRET=escreva_um_segredo_aleatorio_aqui
CPF_ENCRYPTION_KEY=escreva_exatamente_32_caracteres
CPF_HMAC_SECRET=escreva_um_segredo_para_o_hash_do_cpf
