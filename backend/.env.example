# ==========================================
# VARIÁVEIS DE AMBIENTE - MÁQUINA LOCAL
# (Preencha com seus dados locais e renomeie este arquivo para .env)
# ==========================================

# Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=recanto_camargo_teste

# Segredos de Segurança (Não use esses em produção!)
JWT_SECRET=escreva_um_segredo_aleatorio_aqui
CPF_ENCRYPTION_KEY=escreva_exatamente_32_caracteres
CPF_HMAC_SECRET=escreva_um_segredo_para_o_hash_do_cpf

# Email transacional opcional. Chave real somente no .env local/segredos do servidor.
# Para destinatários reais, use um remetente de domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Testes locais: libera POST /api/pagamentos/simular-aprovacao. NUNCA ativar em produção.
PAGAMENTO_SIMULADO=false

# Publicação (produção): origem(ns) do site autorizada(s) a chamar a API, separadas por vírgula.
# Em desenvolvimento pode ficar em branco (usa http://localhost:5173).
CORS_ORIGINS=
# NODE_ENV=production liga cookie "secure" (HTTPS obrigatório). COOKIE_SAMESITE: none (padrão em produção,
# site e API em domínios diferentes), lax ou strict.
NODE_ENV=development
COOKIE_SAMESITE=
